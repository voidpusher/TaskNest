{
  "name": "tasknest",
  "version": "1.9.0",
  "description": "A calm desktop to-do list with a resizable widget mode.",
  "main": "main.js",
  "author": "TaskNest",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "build:web": "node build-web.js"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tasknest.desktop",
    "productName": "TaskNest",
    "asar": true,
    "asarUnpack": [
      "voice-recognition.ps1"
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "widget.html",
      "widget.css",
      "widget.js",
      "voice-recognition.ps1",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "TaskNest-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TaskNest"
    }
  }
}
