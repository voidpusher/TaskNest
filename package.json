{
  "name": "tasknest",
  "version": "2.4.6",
  "description": "Worko, a focused daily planner with a resizable desktop widget.",
  "main": "main.js",
  "author": "Worko",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "build:web": "node build-web.js"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tasknest.desktop",
    "productName": "Worko",
    "asar": true,
    "asarUnpack": [
      "voice-recognition.ps1"
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "creative.css",
      "revamp.css",
      "night.css",
      "worko.css",
      "renderer.js",
      "widget.html",
      "widget.css",
      "worko-widget.css",
      "widget.js",
      "voice-recognition.ps1",
      "service-worker.js",
      "manifest.webmanifest",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/worko-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Worko-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Worko"
    }
  }
}
